---
import BaseLayout from '../layouts/BaseLayout.astro';
const formRecipient = 'c872bc899cb3fe3476e789952e0e3bce';
---
<BaseLayout title="Contact — Your Name">
  <section class="simple-page page-width">
    <span class="eyebrow">Say hello</span>
    <h1 class="serif">Contact</h1>
    <div class="contact-form">
      <p class="contact-intro">Have a project, question, or good idea? Send a note and I’ll get back to you.</p>
      <form action={`https://formsubmit.co/${formRecipient}`} method="POST">
        <input type="hidden" name="_subject" value="New portfolio contact message" />
        <input type="hidden" name="_template" value="table" />
        <input type="text" name="_honey" class="form-honeypot" tabindex="-1" autocomplete="off" />
        <div class="form-grid">
          <label class="form-field">Name<input name="name" type="text" placeholder="Your name" autocomplete="name" required /></label>
          <label class="form-field">Email<input name="email" type="email" placeholder="you@example.com" autocomplete="email" required /></label>
          <label class="form-field full">Message<textarea name="message" placeholder="What’s on your mind?" required></textarea></label>
        </div>
        <button class="form-submit eyebrow" type="submit">Send message ↗</button>
      </form>
      <p class="form-note">Messages are delivered securely through FormSubmit.</p>
    </div>
  </section>
</BaseLayout>
